{
  "rewrites": [
    { "source": "/seg", "destination": "/api/seg" },
    { "source": "/health", "destination": "/api/seg" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Range, Content-Type, Origin, Accept, Authorization" }
      ]
    }
  ]
}
